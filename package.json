{
  "name": "prismcrawl",
  "version": "0.2.0",
  "description": "Official TypeScript and JavaScript client for the PrismCrawl API: search results, places, app stores, products, and reviews as structured JSON.",
  "keywords": [
    "prismcrawl",
    "sdk",
    "api-client",
    "serp",
    "serp-api",
    "search",
    "google",
    "bing",
    "amazon",
    "maps",
    "reviews",
    "web-scraping"
  ],
  "homepage": "https://www.prismcrawl.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/prismcrawl/prismcrawl-node.git"
  },
  "bugs": "https://github.com/prismcrawl/prismcrawl-node/issues",
  "license": "MIT",
  "author": "PrismCrawl <support@prismcrawl.com>",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "generate:fetch": "node scripts/generate.mjs --fetch",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:package": "publint && attw --pack . --profile node16",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@types/node": "^22.20.4",
    "openapi-typescript": "^7.13.0",
    "publint": "^0.3.24",
    "tsup": "^8.5.1",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
